#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        // マウスボタンとレイヤー切り替えの併用（SW4用）
        lt_mkp: layer_tap_mouse_kp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&mkp>;
        };

        // BLEプロファイル切り替え用：短押しで次へ(NXT)、長押しで削除(CLR)
        bt_ht: bluetooth_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred"; /* 長押しを確実に判定 */
            tapping-term-ms = <2000>;  /* 2.0秒長押しでペアリング解除 */
            bindings = <&bt>, <&bt>;
        };

        rot_msc_v: sensor_rotate_msc_v {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };

        rot_msc_h: sensor_rotate_msc_h {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ピン配置順: SW1(L), SW2(R), SW3(M), SW4(Side), SW5(Mode)
            bindings = <
                &mkp LCLK
                &mkp RCLK
                &mkp MCLK
                &lt_mkp 1 MB4         // 短押し: 戻るボタン, 長押し: scroll_layerへ
                &bt_ht BT_CLR BT_NXT  // 短押し: プロファイル切替, 長押し(2.0秒): ペアリング解除
            >;
            sensor-bindings = <&rot_msc_v SCRL_DOWN SCRL_UP>;
        };

        scroll_layer {
            // SW4長押し中に呼び出されるレイヤー（横スクロール用）
            bindings = <
                &trans
                &trans
                &trans
                &trans
                &trans
            >;
            sensor-bindings = <&rot_msc_h SCRL_RIGHT SCRL_LEFT>;
        };
    };
};
