#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        /* サイドボタン用: 長押しでレイヤー切替(&mo)、短押しでマウスボタン(&mkp) */
        lt_mkp: layer_tap_mouse_kp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&mkp>;
        };

        /* モードボタン用: 2秒長押しでBTクリア、短押しでBT切替 */
        bt_mode: bt_mode_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <2000>;
            bindings = <&bt>, <&bt>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &mkp LCLK
                &mkp RCLK
                &mkp MCLK
                &lt_mkp 1 MB4
                &bt_mode BT_CLR BT_NXT
            >;
            sensor-bindings = <&inc_dec_kp DOWN UP>;
        };

        scroll_layer {
            bindings = <
                &trans
                &trans
                &trans
                &trans
                &trans
            >;
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
        };
    };
};
